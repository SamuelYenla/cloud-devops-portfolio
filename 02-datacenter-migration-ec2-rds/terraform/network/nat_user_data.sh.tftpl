#!/bin/bash
# Turn this instance into a NAT router for the private subnets.
#
# Replaces a managed NAT gateway. The gateway costs $0.045/hr against this
# instance's $0.0042/hr - roughly $29/month - and in exchange gives up managed
# failover, scales bandwidth with instance size, and is a host that needs
# patching. Acceptable here because nothing in this project serves real
# traffic and the whole stack is destroyed after each session.
set -euxo pipefail

# Forward packets between interfaces rather than dropping anything not
# addressed to this host.
echo "net.ipv4.ip_forward=1" > /etc/sysctl.d/99-nat.conf
sysctl -p /etc/sysctl.d/99-nat.conf

# Rewrite the source address of private-subnet traffic to this instance's own,
# so replies come back here to be forwarded on.
PRIMARY_IF=$(ip -o -4 route show to default | awk '{print $5}' | head -n1)
iptables -t nat -A POSTROUTING -o "$PRIMARY_IF" -s ${vpc_cidr} -j MASQUERADE

# Survive a reboot.
dnf install -y iptables-services
service iptables save
systemctl enable --now iptables
